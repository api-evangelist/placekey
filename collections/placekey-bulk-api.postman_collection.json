          "id": "b7b49edd-bd3b-44a0-b819-ca3a1c913f01",
          "name": "Look up Placekeys in bulk",
          "request": {
            "name": "Look up Placekeys in bulk",
            "description": {
              "content": "Resolves up to 100 queries in a single request. Each query may include an optional query_id that is echoed back in the response. All queries in a batch must share the same iso_country_code.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "placekeys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queries\": [\n    {\n      \"query_id\": \"<string>\",\n      \"latitude\": \"<double>\",\n      \"longitude\": \"<double>\",\n      \"location_name\": \"<string>\",\n      \"street_address\": \"<string>\",\n      \"city\": \"<string>\",\n      \"region\": \"<string>\",\n      \"postal_code\": \"<string>\",\n      \"iso_country_code\": \"<string>\",\n      \"place_metadata\": {\n        \"store_id\": \"<string>\",\n        \"phone_number\": \"<string>\",\n        \"website\": \"<string>\",\n        \"naics_code\": \"<string>\",\n        \"mcc_code\": \"<string>\"\n      }\n    },\n    {\n      \"query_id\": \"<string>\",\n      \"latitude\": \"<double>\",\n      \"longitude\": \"<double>\",\n      \"location_name\": \"<string>\",\n      \"street_address\": \"<string>\",\n      \"city\": \"<string>\",\n      \"region\": \"<string>\",\n      \"postal_code\": \"<string>\",\n      \"iso_country_code\": \"<string>\",\n      \"place_metadata\": {\n        \"store_id\": \"<string>\",\n        \"phone_number\": \"<string>\",\n        \"website\": \"<string>\",\n        \"naics_code\": \"<string>\",\n        \"mcc_code\": \"<string>\"\n      }\n    }\n  ],\n  \"options\": {\n    \"strict_address_match\": \"<boolean>\",\n    \"strict_name_match\": \"<boolean>\",\n    \"fields\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "9f7c9b08-9972-4e7e-8359-abca96060510",
              "name": "A list of Placekey results, one per query.",
