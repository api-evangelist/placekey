                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": {\n    \"query_id\": \"<string>\",\n    \"latitude\": \"<double>\",\n    \"longitude\": \"<double>\",\n    \"location_name\": \"<string>\",\n    \"street_address\": \"<string>\",\n    \"city\": \"<string>\",\n    \"region\": \"<string>\",\n    \"postal_code\": \"<string>\",\n    \"iso_country_code\": \"<string>\",\n    \"place_metadata\": {\n      \"store_id\": \"<string>\",\n      \"phone_number\": \"<string>\",\n      \"website\": \"<string>\",\n      \"naics_code\": \"<string>\",\n      \"mcc_code\": \"<string>\"\n    }\n  },\n  \"options\": {\n    \"strict_address_match\": \"<boolean>\",\n    \"strict_name_match\": \"<boolean>\",\n    \"fields\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
