  "info": {
    "_postman_id": "a0446c15-1503-449d-8de9-a8fca9596aa0",
    "name": "Placekey Bulk Lookup API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Placekey API resolves an address, point-of-interest, or latitude/longitude coordinate pair into a Placekey - a free, universal identifier for any physical place. It supports single lookups (POST /placekey) and bulk lookups of up to 100 queries per request (POST /placekeys). Authentication is via the apikey request header.\n\nContact Support:\n Name: Placekey Support",
      "type": "text/plain"
    }
  }
